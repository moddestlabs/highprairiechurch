---
import SeasonalUtilityBar from '../components/SeasonalUtilityBar.astro';
import { getActiveSeason } from '../config/seasons';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "High Prairie Church – A Family",
  description = "Welcome to High Prairie Church! A non-denominational, Bible-based, Christ-focused church serving Leavenworth County since 1861."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const buildSeason = getActiveSeason();
---

<!DOCTYPE html>
<html lang="en" data-season={buildSeason?.id || 'none'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href={`${base}/images/cropped-hpc-32x32.png`} sizes="32x32" />
  <link rel="icon" type="image/png" href={`${base}/images/cropped-hpc-192x192.png`} sizes="192x192" />
  <link rel="apple-touch-icon" href={`${base}/images/cropped-hpc-180x180.png`} />

  <!-- Google Fonts matching the original site -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&family=Rubik:wght@300;400;500;700&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      /* Exact Pagelayer Color Palette from original site */
      --pagelayer-color-primary: #c4e090;      /* Meadow green */
      --pagelayer-color-secondary: #dadedf;    /* Light cool gray */
      --pagelayer-color-text: #1a1b1f;         /* Charcoal text */
      --pagelayer-color-accent: #89b3f1;       /* Sky blue */
      --pagelayer-color-gold: #e3c317;         /* Bright gold hover/active */
      --pagelayer-color-bg-light: #f0f0f1;     /* Light gray section bg */
      --pagelayer-color-teal: #89c1bd;         /* Seafoam teal */
      --pagelayer-color-navy: #18206f;         /* Navy */
      --pagelayer-color-header-blue: #afc9f1;  /* Soft lavender sky blue */

      /* Backward compatible aliases */
      --color-primary: var(--pagelayer-color-primary);
      --color-secondary: var(--pagelayer-color-secondary);
      --color-accent: var(--pagelayer-color-accent);
      --color-navy: var(--pagelayer-color-navy);
      --color-teal: var(--pagelayer-color-teal);
      --color-gold: var(--pagelayer-color-gold);
      --color-bg-light: var(--pagelayer-color-bg-light);
      --color-bg-card: #ffffff;
      --color-text: var(--pagelayer-color-text);
      --color-text-muted: #555962;

      /* Font Families */
      --font-heading: 'Crimson Text', serif;
      --font-title: 'Poppins', sans-serif;
      --font-body: 'Rubik', sans-serif;
      --font-nav: 'Rubik', sans-serif;
      --font-montserrat: 'Montserrat', sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      overflow-x: hidden;
    }

    body {
      font-family: var(--font-body);
      color: var(--color-text);
      background-color: var(--pagelayer-color-bg-light);
      line-height: 1.6;
      font-size: 16px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    h1, h2, h3, h4, h5, h6 {
      color: var(--color-text);
      line-height: 1.3;
      margin-bottom: 0.5rem;
    }

    h1 {
      font-family: var(--font-heading);
      font-size: 3rem;
      font-weight: 700;
      line-height: 1.15;
    }

    h2 {
      font-family: var(--font-body);
      font-size: 2.2rem;
      font-weight: 700;
    }

    h3 {
      font-family: var(--font-heading);
      font-size: 1.8rem;
      font-weight: 600;
    }

    h4 {
      font-family: var(--font-body);
      font-size: 1.35rem;
      font-weight: 500;
    }

    h5 {
      font-family: var(--font-body);
      font-size: 1.25rem;
      font-weight: 500;
    }

    p {
      font-family: var(--font-body);
      font-size: 17px;
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    a {
      color: var(--color-text);
      text-decoration: underline;
      transition: all 0.2s ease;
    }

    a:hover {
      text-decoration: none;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    .container {
      width: 100%;
      max-width: 1280px;
      margin-left: auto;
      margin-right: auto;
      padding-left: 20px;
      padding-right: 20px;
    }

    /* Buttons matching original */
    .btn {
      display: inline-block;
      padding: 10px 24px;
      font-family: var(--font-montserrat);
      font-size: 15px;
      font-weight: 600;
      border-radius: 8px;
      text-align: center;
      cursor: pointer;
      text-decoration: none !important;
      transition: all 0.2s ease;
      border: none;
    }

    .btn-gold {
      background-color: var(--pagelayer-color-gold);
      color: var(--color-text);
    }
    .btn-gold:hover {
      background-color: #cbac0d;
      transform: translateY(-1px);
    }

    /* Seasonal Color Accents (Subtle, tasteful touches) */
    html[data-season="autumn"] {
      --pagelayer-color-gold: #c47e1b;
    }
    html[data-season="autumn"] .btn-gold {
      background-color: #c47e1b;
      color: #ffffff !important;
    }
    html[data-season="autumn"] .btn-gold:hover {
      background-color: #ad6b10;
    }

    html[data-season="christmas"] {
      --pagelayer-color-gold: #9a2b37;
    }
    html[data-season="christmas"] .btn-gold {
      background-color: #9a2b37;
      color: #ffffff !important;
    }
    html[data-season="christmas"] .btn-gold:hover {
      background-color: #7d202b;
    }

    .btn-navy {
      background-color: var(--color-navy);
      color: #ffffff !important;
    }
    .btn-navy:hover {
      background-color: #0e144a;
    }

    .btn-facebook {
      background-color: #1a1b1f;
      color: #ffffff !important;
      border-radius: 25px;
      padding: 8px 24px;
      font-family: var(--font-montserrat);
      font-size: 14px;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none !important;
      border: 2px solid #1a1b1f;
      transition: all 0.3s ease;
    }

    .btn-facebook:hover {
      background-color: transparent;
      color: #1a1b1f !important;
    }

    /* Wave SVG Transitions */
    .wave-divider {
      width: 100%;
      overflow: hidden;
      line-height: 0;
      position: relative;
    }

    .wave-divider svg {
      position: relative;
      display: block;
      width: 100%;
      height: 60px;
    }

    @media (max-width: 768px) {
      .wave-divider svg {
        height: 38px;
      }
    }

    /* Original Header Styling */
    header.site-header {
      background-color: var(--pagelayer-color-header-blue);
      position: relative;
      z-index: 70;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 18px 24px;
      max-width: 1300px;
      margin: 0 auto;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none !important;
      color: var(--color-text);
    }

    .brand-logo {
      width: 44px;
      height: 44px;
      object-fit: contain;
      border-radius: 4px;
    }

    .brand-title {
      font-family: var(--font-heading);
      font-size: 28px;
      font-weight: 600;
      color: var(--color-text);
      line-height: 1.1;
      letter-spacing: -0.3px;
    }

    .nav-menu {
      display: flex;
      list-style: none;
      align-items: center;
      gap: 4px;
      margin: 0;
      padding: 0;
    }

    .nav-item {
      position: relative;
    }

    .nav-link {
      font-family: var(--font-nav);
      font-size: 16px;
      font-weight: 400;
      color: var(--color-text);
      padding: 10px 18px;
      border-radius: 4px;
      display: inline-block;
      text-decoration: none !important;
      transition: background-color 0.2s, color 0.2s;
    }

    .nav-link:hover,
    .nav-item.active > .nav-link,
    .nav-item:hover > .nav-link {
      background-color: var(--pagelayer-color-gold);
      color: var(--color-text);
    }

    /* Original Pagelayer Dropdown */
    .dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      background-color: var(--pagelayer-color-secondary);
      min-width: 220px;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
      list-style: none;
      padding: 0;
      margin: 0;
      display: none;
      z-index: 120;
      border-radius: 4px;
      overflow: hidden;
    }

    .nav-item:hover .dropdown {
      display: block;
    }

    .dropdown a {
      display: block;
      padding: 10px 18px;
      font-family: var(--font-nav);
      font-size: 15px;
      color: var(--color-text);
      text-decoration: none !important;
      transition: background-color 0.2s;
      border-bottom: 1px solid rgba(0, 0, 0, 0.05);
    }

    .dropdown a:hover {
      background-color: var(--pagelayer-color-header-blue);
      color: var(--color-text);
    }

    .dropdown li:last-child a {
      border-bottom: none;
    }

    .mobile-menu-btn {
      display: none;
      background: none;
      border: none;
      font-size: 26px;
      cursor: pointer;
      color: var(--color-text);
      padding: 6px 10px;
    }

    /* Main Content */
    main {
      flex: 1;
      width: 100%;
    }

    /* Original Footer Styling */
    footer.site-footer {
      background-color: var(--pagelayer-color-header-blue);
      color: var(--color-text);
      margin-top: auto;
      position: relative;
      box-shadow: 0px 1px 10px 0px rgba(0, 0, 0, 0.15);
    }

    .footer-top-wave {
      line-height: 0;
      width: 100%;
      overflow: hidden;
    }

    .footer-top-wave svg {
      width: 100%;
      height: 35px;
      display: block;
    }

    .footer-main {
      padding: 40px 20px 30px 20px;
      text-align: center;
      max-width: 1100px;
      margin: 0 auto;
    }

    .footer-title {
      font-family: var(--font-title);
      font-size: 38px;
      font-weight: 700;
      color: var(--color-text);
      text-decoration: none !important;
      display: inline-block;
      margin-bottom: 4px;
    }

    .footer-subtitle {
      font-family: var(--font-body);
      font-size: 17px;
      color: var(--color-text);
      margin-bottom: 22px;
      font-weight: 400;
    }

    .footer-facebook-wrap {
      margin-bottom: 26px;
    }

    .footer-menu {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px 24px;
      list-style: none;
      padding: 0;
      margin: 0 0 20px 0;
    }

    .footer-menu a {
      font-family: var(--font-montserrat);
      font-size: 16px;
      font-weight: 500;
      color: var(--color-text);
      text-decoration: none !important;
      padding: 6px 12px;
      border-radius: 4px;
      transition: background-color 0.2s;
    }

    .footer-menu a:hover {
      background-color: var(--pagelayer-color-bg-light);
    }

    .footer-bottom-bar {
      background-color: var(--pagelayer-color-accent);
      padding: 16px 24px;
    }

    .footer-bottom-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      max-width: 1280px;
      margin: 0 auto;
      font-family: var(--font-montserrat);
      font-size: 15px;
      color: #ffffff;
    }

    .footer-bottom-container a {
      color: #ffffff;
      text-decoration: underline;
    }

    .footer-bottom-container a:hover {
      text-decoration: none;
    }

    /* Subpage Banner Component Styling */
    .subpage-banner {
      background-color: var(--pagelayer-color-bg-light);
      padding: 30px 20px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    }

    .subpage-banner-inner {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 40px;
    }

    .subpage-banner-img {
      width: 48%;
      max-width: 460px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      object-fit: cover;
      height: 240px;
    }

    .subpage-banner-title {
      font-family: var(--font-title);
      font-size: 3.5rem;
      font-weight: 700;
      color: var(--color-text);
      margin: 0;
    }

    @media (max-width: 1024px) and (min-width: 769px) {
      .header-inner {
        padding: 14px 16px;
      }
      .brand-title {
        font-size: 22px;
      }
      .nav-link {
        padding: 8px 12px;
        font-size: 15px;
      }
    }

    @media (max-width: 768px) {
      .mobile-menu-btn {
        display: block;
      }

      .nav-menu {
        display: none;
        flex-direction: column;
        width: 100%;
        position: absolute;
        top: 100%;
        left: 0;
        background-color: var(--pagelayer-color-secondary);
        padding: 16px 0;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        align-items: stretch;
      }

      .nav-menu.active {
        display: flex;
      }

      .nav-link {
        padding: 12px 24px;
        border-radius: 0;
        display: block;
      }

      .dropdown {
        position: static;
        box-shadow: none;
        background-color: rgba(255, 255, 255, 0.3);
        display: block;
        padding-left: 20px;
        border-radius: 0;
      }

      .footer-bottom-container {
        justify-content: center;
        text-align: center;
      }

      .subpage-banner-inner {
        flex-direction: column;
        text-align: center;
        gap: 20px;
      }

      .subpage-banner-img {
        width: 100%;
        max-width: 100%;
        height: 200px;
      }

      .subpage-banner-title {
        font-size: 2.4rem;
      }
    }
  </style>
</head>
<body>

  <!-- Seasonal Top Utility Bar (Auto-managed by date/season) -->
  <SeasonalUtilityBar />

  <!-- Original Header -->
  <header class="site-header">
    <div class="header-inner">
      <a href={`${base}/`} class="brand-link">
        <img src={`${base}/images/cropped-hpc-192x192.png`} alt="High Prairie Church Logo" class="brand-logo" />
        <span class="brand-title">High Prairie Church</span>
      </a>

      <button class="mobile-menu-btn" id="mobile-toggle" aria-label="Toggle navigation">☰</button>

      <ul class="nav-menu" id="nav-links">
        <li class="nav-item">
          <a href={`${base}/about/`} class="nav-link">About Us ▾</a>
          <ul class="dropdown">
            <li><a href={`${base}/about/#beliefs`}>Our Beliefs</a></li>
            <li><a href={`${base}/about/#purpose`}>Our Purpose</a></li>
            <li><a href={`${base}/about/#history`}>Our History</a></li>
            <li><a href={`${base}/about/#staff`}>Our Staff</a></li>
            <li><a href={`${base}/about/#calendar`}>Calendar and Events</a></li>
            <li><a href={`${base}/sermons/`}>All Sermons</a></li>
            <li><a href={`${base}/bulletin/`}>Current Bulletin</a></li>
            <li><a href={`${base}/directory/`}>Member Directory</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a href={`${base}/programs/`} class="nav-link">Programs ▾</a>
          <ul class="dropdown">
            <li><a href={`${base}/programs/#kids`}>Children and Youth</a></li>
            <li><a href={`${base}/programs/#education`}>Education for All Ages</a></li>
            <li><a href={`${base}/programs/#activities`}>Family Activities</a></li>
            <li><a href={`${base}/programs/#missions`}>Our Missions</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a href={`${base}/directory/`} class="nav-link">Directory</a>
        </li>
        <li class="nav-item">
          <a href={`${base}/contact/`} class="nav-link">Contact Us</a>
        </li>
        <li class="nav-item">
          <a href={`${base}/donations/`} class="nav-link">Donate</a>
        </li>
      </ul>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <!-- Original Footer -->
  <footer class="site-footer">
    <div class="footer-main">
      <a href={`${base}/`} class="footer-title">High Prairie Church</a>
      <div class="footer-subtitle">Come be part of our family.</div>

      <div class="footer-facebook-wrap">
        <a href="https://www.facebook.com/HPCLeavenworth/" target="_blank" rel="noopener" class="btn-facebook">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z"/></svg>
          Facebook
        </a>
      </div>

      <ul class="footer-menu">
        <li><a href={`${base}/`}>Home</a></li>
        <li><a href={`${base}/about/`}>About Us</a></li>
        <li><a href={`${base}/programs/`}>Programs</a></li>
        <li><a href={`${base}/directory/`}>Directory</a></li>
        <li><a href={`${base}/contact/`}>Contact Us</a></li>
        <li><a href={`${base}/donations/`}>Donate</a></li>
      </ul>
    </div>

    <!-- Wavy Divider above copyright -->
    <div class="footer-top-wave">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" preserveAspectRatio="none">
        <path fill="var(--pagelayer-color-accent)" d="M790.5,93.1c-59.3-5.3-116.8-18-192.6-50c-29.6-12.7-76.9-31-100.5-35.9c-23.6-4.9-52.6-7.8-75.5-5.3c-10.2,1.1-22.6,1.4-50.1,7.4c-27.2,6.3-58.2,16.6-79.4,24.7c-41.3,15.9-94.9,21.9-134,22.6C72,58.2,0,25.8,0,25.8V100h1000V65.3c0,0-51.5,19.4-106.2,25.7C839.5,97,814.1,95.2,790.5,93.1z"></path>
      </svg>
    </div>

    <div class="footer-bottom-bar">
      <div class="footer-bottom-container">
        <div>
          © {new Date().getFullYear()} High Prairie Church. All rights reserved.
        </div>
        <div>
          <a href={`${base}/privacy-policy/`}>Privacy Policy</a>
        </div>
      </div>
    </div>
  </footer>

  <script>
    import { SEASONS, isDateInSeason } from '../config/seasons';

    const toggleBtn = document.getElementById('mobile-toggle');
    const navLinks = document.getElementById('nav-links');
    if (toggleBtn && navLinks) {
      toggleBtn.addEventListener('click', () => {
        navLinks.classList.toggle('active');
      });
    }

    // Synchronize seasonal styling attribute if preview parameter or client date differs
    const params = new URLSearchParams(window.location.search);
    const previewParam = params.get('season');
    if (previewParam) {
      document.documentElement.setAttribute('data-season', previewParam);
    } else {
      const now = new Date();
      const active = SEASONS.find(s => isDateInSeason(now.getMonth() + 1, now.getDate(), s.start, s.end));
      document.documentElement.setAttribute('data-season', active ? active.id : 'none');
    }
  </script>
</body>
</html>
