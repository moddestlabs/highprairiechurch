---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Lead Pastor Search – High Prairie Church">
  <div class="subpage-banner">
    <div class="subpage-banner-inner">
      <img src={`${base}/images/glowing-cross.jpg`} alt="Pastor Search" class="subpage-banner-img" />
      <h1 class="subpage-banner-title">Pastor Search</h1>
    </div>
  </div>

  <div class="container page-content">
    <div class="job-card">
      <div class="job-badge">Ministry Opportunity</div>
      <h2>Lead Pastor Position</h2>
      <div class="job-meta">High Prairie Church • Non-Denominational • Leavenworth County, Kansas</div>

      <div class="job-section">
        <h3>General Description</h3>
        <p>
          High Prairie Church is seeking a Godly, biblically grounded Lead Pastor who will shepherd our congregation with sound biblical preaching, pastoral care, and spiritual leadership in accordance with God's Word.
        </p>
      </div>

      <div class="job-section">
        <h3>Specific Areas of Responsibility</h3>
        <ul class="job-list">
          <li>Directs and mentors staff members: Youth Pastor, Pianist, and Church Secretary.</li>
          <li>Attends regular monthly and special meetings of the Elder Board.</li>
          <li>Attends other church boards and committees as an ex-officio member as needed.</li>
          <li>Provides spiritual, vocational, and relational leadership to the church staff and coordinates regular meetings to pray for one another and encourage ministry momentum.</li>
          <li>Faithfully visits church members in hospitals, care facilities, and homes. Conducts biblically sound personal counseling as required.</li>
          <li>Oversees the planning of Sunday worship and special services. Faithfully conducts pastoral duties (weddings, funerals, baptisms, baby dedications) as circumstances require.</li>
          <li>Presides at the church for regular Sunday worship services, prayer meetings, and special events.</li>
          <li>Directs the preaching ministry and pulpit schedule of the church (all preaching and guest speakers are coordinated through the Lead Pastor).</li>
          <li>Helps publish church communications and newsletters.</li>
        </ul>
      </div>

      <div class="job-section">
        <h3>Compensation & Benefits</h3>
        <p>
          The Pastor's salary and all fiscal benefits are proposed annually by the Elders and approved by the Congregation. Vacation periods, ministry study leave, and sick leave are established by the Elders. A housing allowance is provided.
        </p>
      </div>

      <div class="job-section">
        <h3>Education & Qualifications</h3>
        <ul class="job-list">
          <li>Graduate professional degree in Divinity, Theology, or related biblical field preferred.</li>
          <li>Evident spiritual maturity and character aligning with the biblical qualifications of an Elder (1 Timothy 3; Titus 1).</li>
          <li>Utilizes modern communication tools and technology wisely to enhance ministry and research.</li>
          <li>Standard background check required for all final candidates.</li>
        </ul>
      </div>

      <div class="apply-box">
        <h3>How to Apply</h3>
        <p>
          Interested applicants are invited to submit:
        </p>
        <ol style="margin-left: 20px; margin-bottom: 16px;">
          <li>Cover letter of introduction</li>
          <li>Current resume / curriculum vitae</li>
          <li>Audio or video sermon links/samples</li>
          <li>Three (3) letters of reference</li>
        </ol>
        <p>
          Please email all materials to: <br />
          <a href="mailto:hpcpastorsearch@gmail.com" class="apply-email">✉️ hpcpastorsearch@gmail.com</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>


  .page-content {
    max-width: 900px;
    padding: 40px 20px 80px 20px;
  }

  .job-card {
    background: #ffffff;
    padding: 48px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    border-top: 4px solid var(--color-navy);
  }

  .job-badge {
    display: inline-block;
    background: #f0f4ff;
    color: var(--color-navy);
    font-family: var(--font-nav);
    font-weight: 700;
    font-size: 13px;
    padding: 4px 12px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  .job-card h2 {
    color: var(--color-navy);
    font-size: 2.2rem;
    margin-bottom: 6px;
  }

  .job-meta {
    font-family: var(--font-nav);
    font-size: 15px;
    color: var(--color-text-muted);
    margin-bottom: 30px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e2e8f0;
  }

  .job-section {
    margin-bottom: 32px;
  }

  .job-section h3 {
    font-family: var(--font-title);
    font-size: 1.35rem;
    color: var(--color-navy);
    margin-bottom: 12px;
  }

  .job-list {
    margin-left: 20px;
  }

  .job-list li {
    padding: 6px 0;
    font-size: 16px;
  }

  .apply-box {
    background: #f8fafc;
    padding: 30px;
    border-radius: 10px;
    border-left: 4px solid var(--color-gold);
    margin-top: 40px;
  }

  .apply-box h3 {
    color: var(--color-navy);
    margin-bottom: 10px;
  }

  .apply-email {
    display: inline-block;
    margin-top: 10px;
    font-family: var(--font-nav);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-navy);
  }

  @media (max-width: 768px) {
    .job-card { padding: 28px 20px; }
  }
</style>
