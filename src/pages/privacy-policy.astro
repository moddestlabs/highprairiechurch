---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Privacy Policy – High Prairie Church">
  <div class="page-header">
    <div class="container">
      <h1>Privacy Policy</h1>
      <p>High Prairie Church • Leavenworth, Kansas</p>
    </div>
  </div>

  <div class="container page-content">
    <div class="policy-card">
      <h2>Your Privacy Is Important to Us</h2>
      <p>
        High Prairie Church is committed to protecting your privacy. This statement explains our practices concerning the collection, use, and safeguarding of information when you interact with our website.
      </p>

      <h3>Information We Collect</h3>
      <p>
        When you submit inquiries through our contact forms or email us, we collect the personal contact details you choose to provide (such as your name, email address, and phone number) solely to respond to your communication and address pastoral or ministry needs.
      </p>

      <h3>Online Giving Information</h3>
      <p>
        Online contributions are processed securely through our verified partner, <strong>Zeffy</strong>. High Prairie Church does not store, process, or have access to your sensitive banking details, credit card numbers, or payment tokens. All transactions are encrypted in compliance with industry security standards.
      </p>

      <h3>Information Sharing</h3>
      <p>
        We do not sell, rent, or lease your personal information to third parties. Any information shared with us is used exclusively for internal church communication and pastoral ministry.
      </p>

      <h3>Contact Information</h3>
      <p>
        If you have questions regarding this privacy policy, please contact our church office at:<br />
        <strong>High Prairie Church</strong><br />
        26480 187th Street, Leavenworth, KS 66048<br />
        Phone: (913) 727-1576<br />
        Email: <a href="mailto:admin@highprairiechurch.org">admin@highprairiechurch.org</a>
      </p>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-navy) 0%, #283a8c 100%);
    color: #ffffff;
    padding: 50px 0;
    text-align: center;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 3rem;
  }

  .page-header p {
    font-size: 19px;
    color: #d8e2f0;
    margin-top: 8px;
  }

  .page-content {
    max-width: 860px;
    padding: 40px 20px 80px 20px;
  }

  .policy-card {
    background: #ffffff;
    padding: 48px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  .policy-card h2 {
    color: var(--color-navy);
    font-size: 2rem;
    margin-bottom: 16px;
  }

  .policy-card h3 {
    color: var(--color-navy);
    font-size: 1.4rem;
    margin-top: 28px;
    margin-bottom: 10px;
  }

  .policy-card p {
    color: var(--color-text-muted);
    font-size: 16px;
    line-height: 1.7;
    margin-bottom: 16px;
  }
</style>
