---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const bulletinEntry = await getEntry('bulletins', 'current-bulletin');
const data = bulletinEntry ? bulletinEntry.data : {
  title: "Current Weekly Bulletin",
  date: new Date(),
  coverImage: "/images/cover26-7-5.jpg",
  insideImage: "/images/coverinside26-7-5.jpg",
  notesImage: "/images/insertnotes26-7-5.jpg",
  announcements: "Welcome to High Prairie Church! Join us this Sunday for Worship and Sunday School classes for all ages."
};

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title="Weekly Bulletin – High Prairie Church">
  <div class="page-header">
    <div class="container">
      <h1>Weekly Church Bulletin</h1>
      <p>Order of worship, prayer requests, weekly announcements, and sermon outline notes.</p>
    </div>
  </div>

  <div class="container page-content">
    <div class="bulletin-meta-box">
      <div>
        <h2>{data.title}</h2>
        <div class="bulletin-date">📅 Service Date: {formatDate(data.date)}</div>
      </div>
      <div>
        <a href="#bulletin-pages" class="btn btn-navy">View Scanned Pages ↓</a>
      </div>
    </div>

    {data.announcements && (
      <div class="announcements-card">
        <h3>Weekly Announcements & Highlights</h3>
        <p>{data.announcements}</p>
      </div>
    )}

    <!-- Bulletin Scans Gallery -->
    <div id="bulletin-pages" class="bulletin-gallery">
      <div class="bulletin-page-card">
        <div class="page-title">Page 1: Front Cover & Order of Service</div>
        <a href={`${base}${data.coverImage}`} target="_blank" title="Click to view full size">
          <img src={`${base}${data.coverImage}`} alt="Bulletin Cover" class="bulletin-img" />
        </a>
        <div class="zoom-hint">🔍 Click image to view full high-resolution scan</div>
      </div>

      <div class="bulletin-page-card">
        <div class="page-title">Page 2: Inside Cover & Announcements</div>
        <a href={`${base}${data.insideImage}`} target="_blank" title="Click to view full size">
          <img src={`${base}${data.insideImage}`} alt="Bulletin Inside" class="bulletin-img" />
        </a>
        <div class="zoom-hint">🔍 Click image to view full high-resolution scan</div>
      </div>

      <div class="bulletin-page-card">
        <div class="page-title">Page 3: Insert & Sermon Notes</div>
        <a href={`${base}${data.notesImage}`} target="_blank" title="Click to view full size">
          <img src={`${base}${data.notesImage}`} alt="Bulletin Insert Notes" class="bulletin-img" />
        </a>
        <div class="zoom-hint">🔍 Click image to view full high-resolution scan</div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-navy) 0%, #283a8c 100%);
    color: #ffffff;
    padding: 50px 0;
    text-align: center;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 3rem;
  }

  .page-header p {
    font-size: 19px;
    color: #d8e2f0;
    max-width: 700px;
    margin: 10px auto 0 auto;
  }

  .page-content {
    padding: 40px 20px 80px 20px;
    max-width: 1000px;
  }

  .bulletin-meta-box {
    background: #ffffff;
    padding: 30px;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 30px;
    border-left: 4px solid var(--color-gold);
  }

  .bulletin-meta-box h2 {
    color: var(--color-navy);
    font-size: 1.8rem;
    margin-bottom: 4px;
  }

  .bulletin-date {
    font-family: var(--font-nav);
    font-size: 15px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .announcements-card {
    background: #ffffff;
    padding: 28px;
    border-radius: 12px;
    box-shadow: 0 4px 14px rgba(0,0,0,0.05);
    margin-bottom: 40px;
  }

  .announcements-card h3 {
    color: var(--color-navy);
    font-size: 1.4rem;
    margin-bottom: 12px;
  }

  .bulletin-gallery {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .bulletin-page-card {
    background: #ffffff;
    padding: 24px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border: 1px solid #e2e8f0;
  }

  .page-title {
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid #edf2f7;
  }

  .bulletin-img {
    width: 100%;
    border-radius: 6px;
    transition: opacity 0.2s;
    border: 1px solid #e2e8f0;
  }

  .bulletin-img:hover {
    opacity: 0.95;
  }

  .zoom-hint {
    text-align: center;
    font-size: 13.5px;
    font-family: var(--font-nav);
    color: var(--color-text-muted);
    margin-top: 12px;
  }
</style>
