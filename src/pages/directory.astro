---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Member Directory – High Prairie Church" description="Access the High Prairie Church online member directory via web browser or mobile app. Stay connected with your church family.">
  <div class="subpage-banner">
    <div class="subpage-banner-inner">
      <img src={`${base}/images/dinner.jpg`} alt="Church Family Fellowship" class="subpage-banner-img" />
      <h1 class="subpage-banner-title">Member Directory</h1>
    </div>
  </div>

  <div class="container page-content">
    <!-- Intro Card -->
    <div class="intro-card">
      <div class="intro-badge">Church Family Connection</div>
      <h2>Connect with Your Church Family</h2>
      <p class="intro-lead">
        Our member directory helps High Prairie Church families stay in touch, put names to friendly faces, pray for one another, and build a closer fellowship.
      </p>
      <p class="intro-sub">
        You can access our directory through your <strong>web browser</strong> or right from your smartphone or tablet using the <strong>free mobile app</strong>.
      </p>
    </div>

    <!-- Access Methods Grid -->
    <div class="access-grid">
      <!-- Web Browser Card -->
      <div class="access-card web-card">
        <div class="access-card-header">
          <div class="card-icon-wrap">
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div>
            <h3>Access Online via Website</h3>
            <span class="access-card-subtitle">Best for desktop computers & laptops</span>
          </div>
        </div>

        <p class="access-desc">
          Log in directly through your web browser to view member names, addresses, phone numbers, and family photos.
        </p>

        <div class="cta-action">
          <a
            href="https://members.instantchurchdirectory.com"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-navy btn-directory-link"
          >
            <span>Open Online Directory</span>
            <svg class="external-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
          <span class="url-hint">members.instantchurchdirectory.com</span>
        </div>

        <div class="card-steps">
          <h4>How to Sign In:</h4>
          <ol>
            <li>Click the <strong>Open Online Directory</strong> button above.</li>
            <li>Enter the email address you have registered with High Prairie Church.</li>
            <li>Enter your password, or click <em>"First time signing in? Create a login"</em> if this is your first visit.</li>
          </ol>
        </div>
      </div>

      <!-- Mobile App Card -->
      <div class="access-card mobile-card">
        <div class="access-card-header">
          <div class="card-icon-wrap">
            <svg class="card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <line x1="12" y1="18" x2="12.01" y2="18"></line>
            </svg>
          </div>
          <div>
            <h3>Access via Mobile App</h3>
            <span class="access-card-subtitle">For iPhone, iPad & Android devices</span>
          </div>
        </div>

        <p class="access-desc">
          Take the directory anywhere! Look up phone numbers, send a quick text or email, and get directions with a single tap.
        </p>

        <div class="app-store-buttons">
          <!-- Apple App Store -->
          <a
            href="https://apps.apple.com/us/app/instant-church-directory/id589542221"
            target="_blank"
            rel="noopener noreferrer"
            class="store-badge-btn"
            title="Download on Apple App Store"
          >
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.38c.62-.75 1.04-1.8 0.93-2.85-.9.04-1.99.6-2.63 1.35-.57.65-1.07 1.71-.93 2.73 1 .08 2.01-.48 2.63-1.23z"/>
            </svg>
            <div class="store-text">
              <span class="store-small">Download on the</span>
              <span class="store-big">Apple App Store</span>
            </div>
          </a>

          <!-- Google Play Store -->
          <a
            href="https://play.google.com/store/apps/details?id=com.instantchurchdirectory.members"
            target="_blank"
            rel="noopener noreferrer"
            class="store-badge-btn"
            title="Get it on Google Play"
          >
            <svg class="store-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a2.022 2.022 0 0 1-.22-.924V2.738c0-.342.08-.661.219-.924zm11.24 11.24l2.25 2.25-11.458 6.574 9.208-8.824zm0-2.108L5.641 2.122 17.099 8.696l-2.25 2.25zm1.488 1.488l2.973-1.706c.928-.532.928-1.404 0-1.936l-2.973-1.706-2.182 2.182 2.182 2.166z"/>
            </svg>
            <div class="store-text">
              <span class="store-small">GET IT ON</span>
              <span class="store-big">Google Play</span>
            </div>
          </a>
        </div>

        <div class="card-steps">
          <h4>How to Set Up the App:</h4>
          <ol>
            <li>Download and install <strong>Instant Church Directory</strong> from your app store.</li>
            <li>Open the app and enter your email address.</li>
            <li>Sign in using the exact same password you use on the website.</li>
          </ol>
        </div>
      </div>
    </div>

    <!-- Essential Setup & Tips Callout -->
    <div class="info-columns">
      <!-- First Time Sign-in Guidance -->
      <div class="info-card highlight-card">
        <div class="info-card-header">
          <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <h3>First Time Signing In?</h3>
        </div>
        <div class="info-card-body">
          <div class="tip-item">
            <strong>Email on file required:</strong> Your email address must be listed in our church directory database before you can create an account or sign in.
          </div>
          <div class="tip-item">
            <strong>Creating your password:</strong> Choose <em>"First time signing in? Create a login"</em> on the login screen. You will receive an automated email from Instant Church Directory with a secure link to create your password.
          </div>
          <div class="tip-item">
            <strong>One login for everything:</strong> The same email address and password work for both the website and the mobile app.
          </div>
        </div>
      </div>

      <!-- Need Help / Update Info -->
      <div class="info-card help-card">
        <div class="info-card-header">
          <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          <h3>Need to be Added or Update Your Info?</h3>
        </div>
        <div class="info-card-body">
          <p>
            Are you new to High Prairie Church, unable to sign in, or need to update your family’s phone number, address, or picture?
          </p>
          <div class="contact-box">
            <p class="contact-name"><strong>Bill Packwood</strong> – Administrative Assistant</p>
            <p>
              Email: <a href="mailto:admin@highprairiechurch.org">admin@highprairiechurch.org</a>
            </p>
            <p>
              Church Office Phone: <a href="tel:9137271576">(913) 727-1576</a>
            </p>
          </div>
          <p class="privacy-note">
            <svg class="lock-mini" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            <em>The directory is private and password-protected. Only church members and regular attenders approved by church leadership are granted access.</em>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 80px 20px;
  }

  /* Intro Card */
  .intro-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 36px 40px;
    margin-bottom: 36px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    text-align: center;
  }

  .intro-badge {
    display: inline-block;
    background-color: var(--pagelayer-color-primary);
    color: var(--pagelayer-color-text);
    font-family: var(--font-montserrat);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    padding: 4px 16px;
    border-radius: 20px;
    margin-bottom: 14px;
  }

  .intro-card h2 {
    font-family: var(--font-heading);
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-navy);
    margin-bottom: 14px;
  }

  .intro-lead {
    font-size: 18.5px;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 820px;
    margin: 0 auto 12px auto;
  }

  .intro-sub {
    font-size: 16.5px;
    color: var(--color-text-muted);
    max-width: 780px;
    margin: 0 auto;
  }

  /* Access Methods Grid */
  .access-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin-bottom: 36px;
  }

  .access-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 34px 30px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    border-top: 5px solid var(--pagelayer-color-accent);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .access-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .web-card {
    border-top-color: var(--color-navy);
  }

  .mobile-card {
    border-top-color: var(--pagelayer-color-teal);
  }

  .access-card-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .card-icon-wrap {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    background-color: var(--pagelayer-color-bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .web-card .card-icon-wrap {
    color: var(--color-navy);
    background-color: #eaf1fa;
  }

  .mobile-card .card-icon-wrap {
    color: #177e74;
    background-color: #e6f6f4;
  }

  .card-icon {
    width: 28px;
    height: 28px;
  }

  .access-card-header h3 {
    font-family: var(--font-title);
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 2px;
    line-height: 1.25;
  }

  .access-card-subtitle {
    font-size: 13.5px;
    color: var(--color-text-muted);
    font-family: var(--font-montserrat);
    font-weight: 500;
  }

  .access-desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 24px;
    flex-grow: 0;
  }

  /* CTA Action in Web Card */
  .cta-action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 24px;
  }

  .btn-directory-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    padding: 12px 26px;
    border-radius: 8px;
  }

  .external-icon {
    width: 17px;
    height: 17px;
  }

  .url-hint {
    font-size: 13px;
    color: var(--color-text-muted);
    font-family: var(--font-montserrat);
    padding-left: 4px;
  }

  /* App Store Buttons */
  .app-store-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .store-badge-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background-color: #1a1b1f;
    color: #ffffff !important;
    padding: 10px 20px;
    border-radius: 8px;
    text-decoration: none !important;
    transition: background-color 0.2s, transform 0.2s;
    max-width: 260px;
  }

  .store-badge-btn:hover {
    background-color: #33363f;
    transform: translateY(-1px);
  }

  .store-icon {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
  }

  .store-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.15;
  }

  .store-small {
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.85;
    font-family: var(--font-montserrat);
  }

  .store-big {
    font-size: 15px;
    font-weight: 700;
    font-family: var(--font-montserrat);
  }

  /* Steps Inside Cards */
  .card-steps {
    background-color: var(--pagelayer-color-bg-light);
    border-radius: 8px;
    padding: 18px 20px;
    margin-top: auto;
  }

  .card-steps h4 {
    font-size: 14.5px;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--color-text);
  }

  .card-steps ol {
    padding-left: 20px;
    margin: 0;
  }

  .card-steps li {
    font-size: 14px;
    line-height: 1.55;
    margin-bottom: 8px;
    color: var(--color-text);
  }

  .card-steps li:last-child {
    margin-bottom: 0;
  }

  /* Info / Guidance Columns */
  .info-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .info-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .info-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .info-icon {
    width: 24px;
    height: 24px;
    color: var(--color-navy);
    flex-shrink: 0;
  }

  .info-card-header h3 {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }

  .info-card-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text);
  }

  .tip-item {
    margin-bottom: 14px;
    padding-left: 14px;
    border-left: 3px solid var(--pagelayer-color-accent);
  }

  .tip-item:last-child {
    margin-bottom: 0;
  }

  .contact-box {
    background: var(--pagelayer-color-bg-light);
    border-radius: 8px;
    padding: 14px 18px;
    margin: 14px 0;
  }

  .contact-box p {
    font-size: 14.5px;
    margin-bottom: 6px;
    line-height: 1.5;
  }

  .contact-box p:last-child {
    margin-bottom: 0;
  }

  .contact-name {
    color: var(--color-navy);
  }

  .privacy-note {
    font-size: 13.5px;
    color: var(--color-text-muted);
    margin-top: 14px;
    margin-bottom: 0;
    line-height: 1.5;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .lock-mini {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: #666;
  }

  /* Responsive Adjustments */
  @media (max-width: 860px) {
    .access-grid,
    .info-columns {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .intro-card {
      padding: 26px 20px;
    }

    .intro-card h2 {
      font-size: 1.9rem;
    }

    .intro-lead {
      font-size: 16.5px;
    }

    .access-card {
      padding: 24px 20px;
    }
  }
</style>

