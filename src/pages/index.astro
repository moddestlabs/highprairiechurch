---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="High Prairie Church – A Family">

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="badge">Welcome to Our Church Family</span>
        <h1>Bible-Based,<br /><span class="highlight">Christ-Focused</span></h1>
        <p class="hero-text">
          Everyone is welcome here, whether you are just visiting or looking for a church home. We offer a warm, loving church family with traditional and contemporary worship, Sunday school classes for all ages, and caring ministry for your entire family.
        </p>
        <div class="hero-buttons">
          <a href={`${base}/about/`} class="btn btn-navy">Plan Your Visit</a>
          <a href={`${base}/sermons/`} class="btn btn-outline">Listen to Sermons</a>
          <a href={`${base}/donations/`} class="btn btn-gold">Support Our Ministry</a>
        </div>
      </div>
      <div class="hero-image-wrap">
        <img src={`${base}/images/whole-church.jpg`} alt="High Prairie Church building" class="hero-image" />
      </div>
    </div>

    <!-- Decorative Wave SVG -->
    <div class="hero-wave">
      <svg viewBox="0 0 1000 100" preserveAspectRatio="none">
        <path d="M790.5,93.1c-59.3-5.3-116.8-18-192.6-50c-29.6-12.7-76.9-31-100.5-35.9c-23.6-4.9-52.6-7.8-75.5-5.3c-10.2,1.1-22.6,1.4-50.1,7.4c-27.2,6.3-58.2,16.6-79.4,24.7c-41.3,15.9-94.9,21.9-134,22.6C72,58.2,0,25.8,0,25.8V100h1000V65.3c0,0-51.5,19.4-106.2,25.7C839.5,97,814.1,95.2,790.5,93.1z" fill="#f4f6f8"></path>
      </svg>
    </div>
  </section>

  <!-- Quick Info / Service Times Banner -->
  <section class="times-section">
    <div class="container">
      <div class="times-grid">
        <div class="times-card">
          <div class="times-icon">⏰</div>
          <h3>Sunday Services</h3>
          <ul>
            <li><strong>9:30 AM</strong> — Sunday School (All Ages)</li>
            <li><strong>10:45 AM</strong> — Morning Worship Service</li>
            <li><strong>6:00 PM</strong> — Evening Bible Study</li>
            <li><strong>6:00 PM</strong> — Teen Club</li>
          </ul>
        </div>

        <div class="times-card">
          <div class="times-icon">📖</div>
          <h3>Midweek Studies</h3>
          <ul>
            <li><strong>Monday 6:30 PM</strong> — Men's Bible Study</li>
            <li><strong>Wednesday 9:30 AM</strong> — Ladies Bible Study</li>
            <li><strong>Wednesday 6:30 PM</strong> — Choir Practice</li>
          </ul>
        </div>

        <div class="times-card">
          <div class="times-icon">📍</div>
          <h3>Find Us</h3>
          <p>
            <strong>26480 187th Street</strong><br />
            Leavenworth, KS 66048<br />
            At the intersection of Eisenhower & 187th Street.
          </p>
          <p style="margin-top: 8px;">
            <a href={`${base}/contact/`} class="text-link">Get Directions →</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pastor's Welcome Section -->
  <section class="pastor-welcome-section">
    <div class="container pastor-welcome-container">
      <div class="pastor-img-wrap">
        <img src={`${base}/images/Pastor_Vern.jpg`} alt="Pastor Vernon Welkner" class="pastor-img" />
      </div>
      <div class="pastor-message">
        <span class="badge">A Message from Our Pastor</span>
        <h2>Come Be Part of Our Family</h2>
        <p class="lead-quote">
          "Welcome to High Prairie Church! We are a non-denominational, Bible-based church. Everyone is welcome here, whether you're just coming to visit or you are looking for a church family."
        </p>
        <p>
          We offer a variety of adult, teen, and children's groups, activities, and classes. Our services offer a rich mix of traditional hymns and contemporary music, and a loving nursery is provided during services. We hope to see you soon!
        </p>
        <div class="signature">
          <strong>Pastor Vernon Welkner</strong><br />
          <span>High Prairie Church</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Ministry Grid -->
  <section class="ministries-section">
    <div class="container">
      <div class="section-header">
        <span class="badge">Our Community</span>
        <h2>Explore Our Ministries & Programs</h2>
        <p>Serving God and our neighbors through fellowship, truth, and discipleship.</p>
      </div>

      <div class="ministry-grid">
        <a href={`${base}/about/#beliefs`} class="ministry-card">
          <div class="card-icon">✝️</div>
          <h3>Our Beliefs</h3>
          <p>What our church believes in and sees as our God-given purpose in Christ.</p>
        </a>

        <a href={`${base}/about/#history`} class="ministry-card">
          <div class="card-icon">🏛️</div>
          <h3>Our History</h3>
          <p>Serving Leavenworth County and preaching the Gospel faithfully since 1861!</p>
        </a>

        <a href={`${base}/about/#staff`} class="ministry-card">
          <div class="card-icon">👥</div>
          <h3>Our Staff</h3>
          <p>Meet our pastoral leadership and church staff eager to serve and support you.</p>
        </a>

        <a href={`${base}/sermons/`} class="ministry-card">
          <div class="card-icon">🎙️</div>
          <h3>Sermons</h3>
          <p>Browse our extensive library of past sermons, Scripture studies, and messages.</p>
        </a>

        <a href={`${base}/programs/#education`} class="ministry-card">
          <div class="card-icon">📚</div>
          <h3>Education for All</h3>
          <p>Sunday school and weekday Bible study groups for adults, youth, and young people.</p>
        </a>

        <a href={`${base}/programs/#kids`} class="ministry-card">
          <div class="card-icon">🎈</div>
          <h3>Children & Youth</h3>
          <p>Teens and kids are VIPs here with exciting youth programs, VBS, and activities.</p>
        </a>

        <a href={`${base}/programs/#activities`} class="ministry-card">
          <div class="card-icon">🤝</div>
          <h3>Family Activities</h3>
          <p>Fun, wholesome fellowship, church dinners, and community gatherings.</p>
        </a>

        <a href={`${base}/programs/#missions`} class="ministry-card">
          <div class="card-icon">🌍</div>
          <h3>Our Missions</h3>
          <p>Providing Christ-centered outreach and financial support locally and globally.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Location & Prairie Sky Section -->
  <section class="location-banner">
    <div class="container location-container">
      <div class="location-text">
        <h2>About Our Prairie Location</h2>
        <p>
          High Prairie Church is located 7 miles west of Lansing, Kansas, and 9 miles west of downtown Leavenworth. Out under the broad prairie sky, surrounded by rolling hills, the church seems to be far away from the hustle and bustle of towns and cities. Yet it is only a few minutes away!
        </p>
        <p>
          Access is easy via Springdale Road from Leavenworth and Eisenhower Road from Lansing.
        </p>
        <div style="margin-top: 20px;">
          <a href={`${base}/contact/`} class="btn btn-navy">View Map & Directions</a>
        </div>
      </div>
      <div class="location-img-wrap">
        <img src={`${base}/images/Sunset.church.jpg`} alt="High Prairie Church at sunset" class="location-img" />
      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero-section {
    background: linear-gradient(135deg, #18206f 0%, #283a8c 100%);
    color: #ffffff;
    padding: 60px 0 0 0;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    align-items: center;
    padding-bottom: 60px;
  }

  .badge {
    display: inline-block;
    background-color: rgba(196, 224, 144, 0.25);
    color: var(--color-primary);
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-family: var(--font-nav);
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 14px;
    border: 1px solid rgba(196, 224, 144, 0.4);
  }

  .hero-content h1 {
    color: #ffffff;
    font-size: 3.4rem;
    line-height: 1.15;
    margin-bottom: 20px;
  }

  .highlight {
    color: var(--color-primary);
  }

  .hero-text {
    font-size: 19px;
    line-height: 1.7;
    color: #d8e2f0;
    margin-bottom: 30px;
  }

  .hero-buttons {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-image-wrap {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    border: 4px solid rgba(255, 255, 255, 0.15);
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-wave {
    width: 100%;
    height: 50px;
    margin-top: -10px;
  }

  .hero-wave svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Times Grid */
  .times-section {
    padding: 30px 0 60px 0;
  }

  .times-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .times-card {
    background: #ffffff;
    padding: 32px 28px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    border-top: 4px solid var(--color-navy);
    transition: transform 0.2s;
  }

  .times-card:hover {
    transform: translateY(-4px);
  }

  .times-icon {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .times-card h3 {
    font-family: var(--font-title);
    font-size: 20px;
    margin-bottom: 16px;
    color: var(--color-navy);
  }

  .times-card ul {
    list-style: none;
  }

  .times-card ul li {
    padding: 6px 0;
    border-bottom: 1px dashed #e6e8eb;
    font-size: 15.5px;
  }

  .text-link {
    font-family: var(--font-nav);
    font-weight: 600;
    color: var(--color-navy);
  }

  /* Pastor Section */
  .pastor-welcome-section {
    background-color: #ffffff;
    padding: 70px 0;
  }

  .pastor-welcome-container {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 48px;
    align-items: center;
  }

  .pastor-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .pastor-img {
    width: 100%;
  }

  .pastor-message h2 {
    font-size: 2.6rem;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .lead-quote {
    font-size: 20px;
    font-style: italic;
    color: #2b3648;
    line-height: 1.6;
    margin-bottom: 20px;
    border-left: 4px solid var(--color-gold);
    padding-left: 18px;
  }

  .signature {
    margin-top: 24px;
    font-family: var(--font-nav);
  }
  .signature strong {
    font-size: 18px;
    color: var(--color-navy);
  }

  /* Ministries Section */
  .ministries-section {
    padding: 70px 0;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 50px auto;
  }

  .section-header h2 {
    font-size: 2.6rem;
    color: var(--color-navy);
    margin-bottom: 12px;
  }

  .section-header p {
    color: var(--color-text-muted);
    font-size: 18px;
  }

  .ministry-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .ministry-card {
    background: #ffffff;
    padding: 28px 22px;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    text-decoration: none !important;
    display: flex;
    flex-direction: column;
    transition: all 0.2s ease;
    border: 1px solid #eef0f3;
  }

  .ministry-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.09);
    border-color: var(--color-accent);
  }

  .card-icon {
    font-size: 34px;
    margin-bottom: 12px;
  }

  .ministry-card h3 {
    font-family: var(--font-title);
    font-size: 18px;
    color: var(--color-navy);
    margin-bottom: 8px;
  }

  .ministry-card p {
    font-size: 14.5px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Location Banner */
  .location-banner {
    background-color: #ffffff;
    padding: 60px 0;
    border-top: 1px solid #e2e8f0;
  }

  .location-container {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .location-text h2 {
    font-size: 2.3rem;
    color: var(--color-navy);
    margin-bottom: 16px;
  }

  .location-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  @media (max-width: 992px) {
    .hero-container { grid-template-columns: 1fr; }
    .times-grid { grid-template-columns: 1fr; }
    .ministry-grid { grid-template-columns: repeat(2, 1fr); }
    .pastor-welcome-container { grid-template-columns: 1fr; }
    .location-container { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .ministry-grid { grid-template-columns: 1fr; }
    .hero-content h1 { font-size: 2.4rem; }
  }
</style>
