---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Contact Us – High Prairie Church">
  <div class="subpage-banner">
    <div class="subpage-banner-inner">
      <img src={`${base}/images/OkChoir.png`} alt="Contact Us" class="subpage-banner-img" />
      <h1 class="subpage-banner-title">Contact Us</h1>
    </div>
  </div>

  <div class="container page-content">
    <div class="contact-grid">
      <!-- Contact Info & Directory -->
      <div class="contact-info-col">
        <div class="contact-header-info">
          <h4>
            <a href="https://www.google.com/maps/place/26480+187th+St,+Leavenworth,+KS+66048/@39.253595,-95.0142673,1174m/data=!3m2!1e3!4b1!4m6!3m5!1s0x87c07e563de3853d:0xf63e8be843821ed0!8m2!3d39.2535909!4d-95.0116924!16s%2Fg%2F11c5ptpy8x?entry=ttu&g_ep=EgoyMDI0MDgyNy4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener" class="contact-address-link">
              26480 187th, Leavenworth, KS, 66048
            </a>
          </h4>

          <h4>
            <a href="tel:9137271576" class="contact-phone-link">(913) 727-1576</a>
          </h4>

          <h4>
            <a href="https://www.facebook.com/HPCLeavenworth" target="_blank" rel="noopener" class="contact-fb-link">HPCLeavenworth</a>
          </h4>
        </div>

        <div class="staff-directory-block">
          <div class="directory-section">
            <h4><strong>Pastor</strong></h4>
            <p>
              Vernon Welkner - <a href="mailto:pastorvern@highprairiechurch.org">pastorvern@highprairiechurch.org</a>
            </p>
          </div>

          <div class="directory-section">
            <h4><strong>Youth Minister</strong></h4>
            <p>
              Jerry Mallonee - <a href="mailto:pastorjerry@highprairiechurch.org">pastorjerry@highprairiechurch.org</a>
            </p>
          </div>

          <div class="directory-section">
            <h4><strong>Staff</strong></h4>
            <p>
              Bill Packwood - Administrative Assistant - <a href="mailto:admin@highprairiechurch.org">admin@highprairiechurch.org</a>
            </p>
            <p>
              Jennifer Mallonee - Bookkeeper - <a href="mailto:admin@highprairiechurch.org">admin@highprairiechurch.org</a>
            </p>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-col">
        <div class="form-card">
          <h4><b>Ask a question or leave a comment:</b></h4>

          <form class="contact-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('Thank you for reaching out! Your message has been received.');">
            <div class="form-group">
              <input type="text" name="name" placeholder="Name" required class="form-input" />
            </div>

            <div class="form-group">
              <input type="email" name="email" placeholder="Email" required class="form-input" />
            </div>

            <div class="form-group">
              <input type="text" name="subject" placeholder="Subject" class="form-input" />
            </div>

            <div class="form-group">
              <textarea name="message" rows="8" placeholder="Message" required class="form-textarea"></textarea>
            </div>

            <div class="form-submit-wrap">
              <button type="submit" class="btn-submit">
                <span>Send</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    max-width: 1100px;
    margin: 0 auto;
    padding: 40px 20px 80px 20px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }

  .contact-info-col {
    background: #ffffff;
    padding: 36px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .contact-header-info {
    margin-bottom: 30px;
    padding-bottom: 24px;
    border-bottom: 2px solid var(--pagelayer-color-primary);
  }

  .contact-header-info h4 {
    font-size: 1.25rem;
    font-family: var(--font-body);
    font-weight: 500;
    margin-bottom: 12px;
  }

  .contact-header-info a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .contact-header-info a:hover {
    color: var(--pagelayer-color-navy);
  }

  .directory-section {
    margin-bottom: 20px;
  }

  .directory-section:last-child {
    margin-bottom: 0;
  }

  .directory-section h4 {
    font-size: 1.2rem;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 6px;
  }

  .directory-section p {
    font-size: 15.5px;
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .directory-section a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .form-card {
    background: #ffffff;
    padding: 36px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .form-card h4 {
    font-size: 1.3rem;
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 24px;
  }

  .form-group {
    margin-bottom: 18px;
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-input:focus, .form-textarea:focus {
    border-color: var(--pagelayer-color-accent);
  }

  .form-submit-wrap {
    margin-top: 10px;
  }

  .btn-submit {
    background: var(--pagelayer-color-primary);
    color: var(--color-text);
    font-family: var(--font-nav);
    font-size: 16px;
    font-weight: 600;
    padding: 10px 32px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-submit:hover {
    background: #b5d57b;
  }

  @media (max-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
