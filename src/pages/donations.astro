---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Donate & Support – High Prairie Church">
  <div class="page-header">
    <div class="container">
      <h1>Support High Prairie Church</h1>
      <p>Your generous tax-deductible gift supports our local ministries, worship services, and community outreach.</p>
    </div>
  </div>

  <div class="container page-content">
    <div class="donation-wrap">
      <div class="donation-intro">
        <h2>Online Giving</h2>
        <p>
          Thank you for prayerfully investing in the work of God at High Prairie Church!
        </p>

        <div class="zeffy-notice">
          <strong>ℹ️ A Note Regarding Our Free Giving Service:</strong>
          <p style="margin-top: 6px; font-size: 14.5px;">
            Our payment processor, <strong>Zeffy</strong>, provides 100% of this online donation service to our church free of charge (0% platform fee and 0% credit card processing fee!). To cover their costs, Zeffy gives you the option to make a voluntary contribution to their platform. <em>This is entirely optional.</em> If you do not wish to contribute an extra amount to Zeffy, simply select "Other" and enter "0" in the percentage box when completing your donation.
          </p>
        </div>
      </div>

      <!-- Zeffy Embedded Form -->
      <div class="zeffy-embed-container">
        <iframe
          title="Donation form powered by Zeffy"
          style="border: 0; width: 100%; height: 750px; border-radius: 12px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);"
          src="https://www.zeffy.com/embed/donation-form/donate-online"
          allowpaymentrequest="allowpaymentrequest"
          allowtransparency="true">
        </iframe>
      </div>

      <div class="mail-giving-box">
        <h3>Giving by Mail</h3>
        <p>
          If you prefer to give by check, please make checks payable to <strong>High Prairie Church</strong> and mail to:
        </p>
        <div class="mail-address">
          <strong>High Prairie Church</strong><br />
          26480 187th Street<br />
          Leavenworth, KS 66048
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, var(--color-navy) 0%, #283a8c 100%);
    color: #ffffff;
    padding: 50px 0;
    text-align: center;
  }

  .page-header h1 {
    color: #ffffff;
    font-size: 3rem;
  }

  .page-header p {
    font-size: 19px;
    color: #d8e2f0;
    max-width: 700px;
    margin: 10px auto 0 auto;
  }

  .page-content {
    max-width: 900px;
    padding: 40px 20px 80px 20px;
  }

  .donation-intro h2 {
    color: var(--color-navy);
    font-size: 2.2rem;
    margin-bottom: 12px;
  }

  .zeffy-notice {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-left: 4px solid var(--color-primary-dark);
    padding: 20px;
    border-radius: 8px;
    margin: 24px 0 36px 0;
  }

  .zeffy-notice strong {
    color: #166534;
  }

  .zeffy-embed-container {
    margin-bottom: 40px;
  }

  .mail-giving-box {
    background: #ffffff;
    padding: 32px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    border-top: 3px solid var(--color-navy);
  }

  .mail-giving-box h3 {
    color: var(--color-navy);
    margin-bottom: 10px;
  }

  .mail-address {
    background: #f8fafc;
    padding: 16px;
    border-radius: 6px;
    font-family: var(--font-nav);
    margin-top: 14px;
    display: inline-block;
  }
</style>
