---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Donate – High Prairie Church">
  <div class="subpage-banner">
    <div class="subpage-banner-inner">
      <img src={`${base}/images/glowing-cross.jpg`} alt="Donate" class="subpage-banner-img" />
      <h1 class="subpage-banner-title">Donate</h1>
    </div>
  </div>

  <div class="container page-content">
    <div class="donations-container">
      <p class="donations-intro">
        Your donation supports our programs, services and outreach to the community. Thank you!
      </p>

      <p class="donations-note">
        NOTE: Our payment processor, Zeffy, provides this donation service to us free of charge. They do ask you for an additional donation to reduce their expenses, but this is entirely up to you. If you don't want to make this additional donation, simply change the percentage to zero when Zeffy asks you to contribute a certain percentage to them.
      </p>

      <div class="zeffy-frame-wrap">
        <iframe
          title="Donation form powered by Zeffy"
          style="border: 0; width: 100%; height: 750px; border-radius: 8px;"
          src="https://www.zeffy.com/embed/donation-form/donate-online"
          allowpaymentrequest="allowpaymentrequest"
          allowtransparency="true">
        </iframe>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-content {
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 20px 80px 20px;
  }

  .donations-container {
    background: #ffffff;
    padding: 40px;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  }

  .donations-intro {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text);
    margin-bottom: 16px;
    font-weight: 500;
  }

  .donations-note {
    font-size: 14.5px;
    line-height: 1.6;
    color: #555555;
    background: var(--pagelayer-color-bg-light);
    padding: 16px 20px;
    border-radius: 8px;
    border-left: 4px solid var(--pagelayer-color-accent);
    margin-bottom: 30px;
  }

  .zeffy-frame-wrap {
    width: 100%;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .donations-container {
      padding: 24px 16px;
    }
  }
</style>
